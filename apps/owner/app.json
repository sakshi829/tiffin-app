{
  "expo": {
    "name": "AK Owner",
    "slug": "amrutas-kitchen-owner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "akowner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.amrutaskitchen.owner",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5D3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amrutaskitchen.owner",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F5D3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#A4491A"
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Used only to record voice notes you choose to send to customers.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you choose your UPI QR picture.",
          "cameraPermission": "Lets you take photos for the kitchen app.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlocks the owner app so only you can see customers and money."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
