# Copy to apps/<app>/.env.local ON YOUR PERSONAL LAPTOP and fill in real values there.
# Only PUBLIC values belong in app env files (EXPO_PUBLIC_* is bundled into the app).
# NEVER put the Supabase service_role key, DB password or any secret in an app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY
EXPO_PUBLIC_SENTRY_DSN=
# Customer app only: where the privacy policy is published (https), e.g. https://app.example.in/privacy.html
EXPO_PUBLIC_PRIVACY_URL=

# Server-side secrets live ONLY in:
#   - Supabase dashboard -> Edge Functions -> Secrets  (e.g. EXPO_ACCESS_TOKEN, VAPID_PRIVATE_KEY)
#   - GitHub repo -> Settings -> Secrets and variables -> Actions (e.g. SUPABASE_DB_URL, BACKUP_AGE_PUBLIC_KEY)
